<Window x:Class="ClaudeWorkbench.Launcher.Wpf.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudeWorkbench Launcher — Help"
        Width="700" Height="480" MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Surface}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10">
            <Button Content="Close" MinWidth="88" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryBtn}" IsDefault="True" IsCancel="True" Click="OnClose" />
        </Border>

        <TextBox x:Name="body"
                 Margin="16"
                 IsReadOnly="True"
                 BorderThickness="0"
                 Background="{StaticResource Surface}"
                 Foreground="{StaticResource TextPrimary}"
                 FontSize="13"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
