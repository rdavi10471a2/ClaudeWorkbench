@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@implements IAsyncDisposable
@using ClaudeWorkbench.Host.Services

@* Read-only source viewer. Code renders in one persistent in-app Monaco instance (no iframe), model
   swapped per file. Markdown renders as formatted HTML by default (via the shared, HTML-sanitizing
   MarkdownRenderer), with a Raw toggle that drops back to Monaco source.

   IMPORTANT: the rendered-markdown pane's innerHTML is owned ENTIRELY by JS (setMarkdown), NOT by a
   Blazor MarkupString. This is deliberate — the decoration passes (mermaid replaces <pre>, highlight
   rewrites <code>, decorateDocLinks strips href) mutate that DOM, and if Blazor also managed those
   nodes it would try to reconcile the mutated tree on the next render and crash with
   "Cannot read properties of null (reading 'removeChild')". Blazor sees an EMPTY div and never diffs
   its contents — the same pattern the Monaco container uses. *@
<div class="source-viewer">
    @if (IsMarkdown)
    {
        <div class="source-view-toggle" role="tablist" aria-label="Markdown view mode">
            <button type="button"
                    role="tab"
                    class="@(showRaw ? string.Empty : "active")"
                    aria-selected="@(!showRaw)"
                    @onclick="@(() => SetRawAsync(false))">Rendered</button>
            <button type="button"
                    role="tab"
                    class="@(showRaw ? "active" : string.Empty)"
                    aria-selected="@showRaw"
                    @onclick="@(() => SetRawAsync(true))">Raw</button>
        </div>
    }

    @* Empty by design — JS fills this (see comment above). Never put @@MarkupString content here. *@
    <div class="source-markdown @(ShowRendered ? string.Empty : "hidden")" @ref="markdownContainer"></div>

    <div class="source-monaco @(ShowRendered ? "hidden" : string.Empty)" @ref="container"></div>
</div>

@code {
    [Parameter]
    public SourceFileDocument? File { get; set; }

    // Raised when a relative link inside a rendered markdown doc is clicked; the parent resolves it
    // against the current doc and navigates the viewer to the target file.
    [Parameter]
    public EventCallback<DocLinkNavigation> OnNavigate { get; set; }

    private ElementReference container;
    private ElementReference markdownContainer;
    private IJSObjectReference? module;
    private IJSObjectReference? resizeModule;
    private DotNetObjectReference<SourceCodeViewer>? selfRef;
    private bool ready;

    // Markdown view state. showRaw is a sticky operator preference across files; ShowRendered gates
    // which pane is visible. pushedForPath tracks which doc's HTML is currently in the JS-owned pane.
    private bool showRaw;
    private string? pushedForPath;

    private bool IsMarkdown =>
        File is not null && GetExtension(File) is ".md" or ".markdown";

    private bool ShowRendered => IsMarkdown && !showRaw;

    // A read-only viewer must NEVER crash the app on content it is merely displaying. Any unhandled
    // JS-interop exception in a lifecycle method tears down the Blazor circuit (== the "crash"), so all
    // interop here is guarded.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                // ?v= cache-buster: the launcher's app-window caches JS aggressively; bump on JS change
                // so a republish is actually picked up instead of serving a stale module.
                module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/sourceMonaco.js?v=7");
                await module.InvokeVoidAsync("initEditor", container, Nav.BaseUri);
                // Click handler for neutralized relative links in the rendered-markdown pane.
                selfRef = DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("attachDocLinks", markdownContainer, selfRef);
                resizeModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/sourceResize.js?v=5");
                ready = true;
                await OpenAsync();
            }

            // Push the doc's HTML into the JS-owned pane once per document (markdown only).
            if (ready && IsMarkdown && File is not null && pushedForPath != File.FullPath)
            {
                await RenderMarkdownAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception)
        {
            // Rendering/interop failure must not crash the host.
        }
    }

    // Build the doc's HTML in C#, then hand the whole pane to JS: setMarkdown sets innerHTML and
    // neutralizes relative links; highlight + mermaid decorate it. Blazor never touches this DOM.
    private async Task RenderMarkdownAsync()
    {
        if (module is null || File is null)
        {
            return;
        }

        try
        {
            string html = MarkdownRenderer.ToHtml(File.Text);
            await module.InvokeVoidAsync("setMarkdown", markdownContainer, html);
            if (resizeModule is not null)
            {
                await resizeModule.InvokeVoidAsync("highlightCodeBlocks", markdownContainer);
                await resizeModule.InvokeVoidAsync("renderMermaidBlocks", markdownContainer);
            }

            pushedForPath = File.FullPath;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception)
        {
        }
    }

    // Called from JS when a neutralized relative in-doc link is clicked. File is the doc it came from.
    [JSInvokable]
    public async Task OpenRelativeLink(string href)
    {
        if (File is null || string.IsNullOrWhiteSpace(href))
        {
            return;
        }

        try
        {
            await OnNavigate.InvokeAsync(new DocLinkNavigation(File.RelativePath, href));
        }
        catch (Exception)
        {
            // A bad link must never crash the viewer; a failed navigation is simply inert.
        }
    }

    // File changes as the operator clicks tree nodes; push the new content/line into the live editor.
    // The markdown pane is refreshed from OnAfterRenderAsync (guarded by pushedForPath).
    protected override async Task OnParametersSetAsync()
    {
        if (ready)
        {
            await OpenAsync();
        }
    }

    private async Task OpenAsync()
    {
        if (module is null || File is null)
        {
            return;
        }

        // Guarded: rapid doc switches (double-tap) can call this while a prior swap is in flight or
        // the circuit is tearing down — a throw here would crash the host, so swallow interop errors.
        try
        {
            await module.InvokeVoidAsync(
                "openFile",
                container,
                File.FullPath,
                File.Text,
                GetMonacoLanguage(File),
                File.SelectedLine);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception)
        {
        }
    }

    private async Task SetRawAsync(bool raw)
    {
        showRaw = raw;
        // Monaco was hidden (zero-sized) while the rendered pane showed; force a relayout as it
        // reappears so it doesn't paint at 0x0, then re-reveal the current line.
        if (raw && module is not null && ready)
        {
            try
            {
                await module.InvokeVoidAsync("relayout", container);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (Exception)
            {
            }

            await OpenAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose", container);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        if (resizeModule is not null)
        {
            try
            {
                await resizeModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        selfRef?.Dispose();
    }

    private static string GetExtension(SourceFileDocument file)
    {
        return Path.GetExtension(file.RelativePath).ToLowerInvariant();
    }

    private static string GetMonacoLanguage(SourceFileDocument file)
    {
        return GetExtension(file) switch
        {
            ".cs" => "csharp",
            ".razor" => "html",
            ".cshtml" => "html",
            ".json" => "json",
            ".xml" => "xml",
            ".xaml" => "xml",
            ".md" => "markdown",
            ".markdown" => "markdown",
            ".css" => "css",
            ".html" => "html",
            ".js" => "javascript",
            ".ts" => "typescript",
            ".csproj" => "xml",
            ".sln" => "plaintext",
            ".slnx" => "xml",
            _ => "plaintext"
        };
    }
}
