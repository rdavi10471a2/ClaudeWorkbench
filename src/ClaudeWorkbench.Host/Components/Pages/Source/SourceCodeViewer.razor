@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@implements IAsyncDisposable

@* Read-only source viewer: one persistent in-app Monaco instance (no iframe), model swapped per file
   via JS interop. Click-a-node -> OpenAsync(path, line) reveals the line — same navigation as before. *@
<div class="source-monaco" @ref="container"></div>

@code {
    [Parameter]
    public SourceFileDocument? File { get; set; }

    private ElementReference container;
    private IJSObjectReference? module;
    private bool ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/sourceMonaco.js");
        await module.InvokeVoidAsync("initEditor", container, Nav.BaseUri);
        ready = true;
        await OpenAsync();
    }

    // File changes as the operator clicks tree nodes; push the new content/line into the live editor.
    protected override async Task OnParametersSetAsync()
    {
        if (ready)
        {
            await OpenAsync();
        }
    }

    private async Task OpenAsync()
    {
        if (module is null || File is null)
        {
            return;
        }

        await module.InvokeVoidAsync(
            "openFile",
            container,
            File.FullPath,
            File.Text,
            GetMonacoLanguage(File),
            File.SelectedLine);
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose", container);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private static string GetMonacoLanguage(SourceFileDocument file)
    {
        string extension = Path.GetExtension(file.RelativePath);
        return extension.ToLowerInvariant() switch
        {
            ".cs" => "csharp",
            ".razor" => "html",
            ".cshtml" => "html",
            ".json" => "json",
            ".xml" => "xml",
            ".xaml" => "xml",
            ".md" => "markdown",
            ".css" => "css",
            ".html" => "html",
            ".js" => "javascript",
            ".ts" => "typescript",
            ".csproj" => "xml",
            ".sln" => "plaintext",
            ".slnx" => "xml",
            _ => "plaintext"
        };
    }
}
