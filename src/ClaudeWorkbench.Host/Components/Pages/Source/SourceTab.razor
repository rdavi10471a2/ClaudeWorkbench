@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="source-shell">
    @* Workspace ops up top — index/solution actions that act on the whole workspace. Tree navigation
       controls live with the tree (below). *@
    <div class="source-top-toolbar">
        <div class="source-top-left">
            <RadzenButton Icon="arrow_back"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Title="Back (previous file)"
                          Disabled="@(!CanGoBack)"
                          Click="@Back" />
            <RadzenButton Icon="arrow_forward"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Title="Forward (next file)"
                          Disabled="@(!CanGoForward)"
                          Click="@Forward" />
            <span class="source-toolbar-divider" aria-hidden="true"></span>
            <RadzenButton Icon="sync"
                          Text="Refresh"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Title="Re-read the current source without rebuilding the index"
                          Click="@Reload" />
            <RadzenButton Icon="refresh"
                          Text="Rebuild Index"
                          BusyText="Indexing..."
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Title="Re-index the whole solution"
                          Click="@RebuildIndex"
                          IsBusy="@IsRebuildingIndex" />

            <span class="source-toolbar-divider" aria-hidden="true"></span>

            <RadzenButton Icon="build"
                          Text="Build"
                          BusyText="Building..."
                          ButtonStyle="ButtonStyle.Success"
                          Size="ButtonSize.Small"
                          Title="Build the solution to real output (bin/<config>)"
                          Click="@(() => Build.InvokeAsync(buildConfiguration))"
                          IsBusy="@IsBuilding"
                          Disabled="@IsBuilding" />
            <select class="source-build-config"
                    @bind="buildConfiguration"
                    title="Build configuration"
                    disabled="@IsBuilding">
                <option value="Debug">Debug</option>
                <option value="Release">Release</option>
            </select>

            @* Startup-project picker — like VS's dropdown next to the play button. Lists the solution's
               executable projects (from the index) so Run is never ambiguous when there's more than one. *@
            <select class="source-run-project"
                    @bind="selectedRunProject"
                    title="Project to run"
                    disabled="@(IsBuilding || Snapshot.RunnableProjects.Count == 0)">
                @if (Snapshot.RunnableProjects.Count == 0)
                {
                    <option value="">No executable project</option>
                }
                @foreach (RunnableProjectEntry project in Snapshot.RunnableProjects)
                {
                    <option value="@project.ProjectPath">@project.Name</option>
                }
            </select>
            <RadzenButton Icon="play_arrow"
                          Text="Run"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Title="Build and launch the selected executable project"
                          Click="@RunSelected"
                          Disabled="@(IsBuilding || Snapshot.RunnableProjects.Count == 0)" />
            <RadzenButton Icon="stop"
                          Text="Stop"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Title="Stop the app launched from here (releases its exe lock so the next Build/Run works)"
                          Click="@Stop" />
        </div>
        <div class="source-top-right">
            <RadzenButton Icon="add"
                          Text="Add project"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Title="Scaffold a new C# project into the watched solution"
                          Click="@AddProject" />
        </div>
    </div>

    <div class="source-layout" @ref="sourceLayout">
        <aside class="source-sidebar" @ref="sourceSidebar" aria-label="Workspace source files">
            @* Two trees, not a toggle: Symbols (index-backed, code + symbols) and Files (a plain
               git-tracked file browser). Each keeps its own filter; both feed the same viewer. *@
            <div class="source-tree-tabs" role="tablist">
                <button type="button"
                        role="tab"
                        class="source-tree-tab @(activeTree == TreeMode.Solution ? "active" : string.Empty)"
                        aria-selected="@(activeTree == TreeMode.Solution)"
                        @onclick="@(() => SetTree(TreeMode.Solution))">Solution</button>
                <button type="button"
                        role="tab"
                        title="Files listed from Git (git ls-files): tracked + new files, respecting .gitignore"
                        class="source-tree-tab @(activeTree == TreeMode.Files ? "active" : string.Empty)"
                        aria-selected="@(activeTree == TreeMode.Files)"
                        @onclick="@(() => SetTree(TreeMode.Files))">Files</button>
            </div>

            <div class="source-tree-toolbar">
                <div class="source-tree-tools">
                    <RadzenButton Icon="unfold_less"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Title="Collapse all"
                                  Click="@CollapseAll" />
                    <RadzenButton Icon="unfold_more"
                                  ButtonStyle="ButtonStyle.Light"
                                  Size="ButtonSize.Small"
                                  Title="Expand all"
                                  Click="@ExpandAll" />
                    <RadzenButton Icon="search"
                                  ButtonStyle="@(showFilter ? ButtonStyle.Info : ButtonStyle.Light)"
                                  Size="ButtonSize.Small"
                                  Title="Filter files"
                                  Click="@ToggleFilter" />
                </div>
                <span class="source-count">@ActiveCount file@(ActiveCount == 1 ? string.Empty : "s")</span>
            </div>

            @if (showFilter)
            {
                <div class="source-filter-row">
                    <RadzenTextBox Value="@ActiveFilter" Change="@OnActiveFilterChanged" Placeholder="Filter files" />
                    <RadzenButton Icon="search" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ApplyActiveFilter" />
                </div>
            }

            @if (activeTree == TreeMode.Files)
            {
                <div class="source-git-note" title="git ls-files --cached --others --exclude-standard">
                    <RadzenIcon Icon="account_tree" />
                    <span>From Git — tracked + new files (respects .gitignore).</span>
                </div>
            }

            <div class="source-tree-list" @ref="treeList">
                @if (ActiveTreeNodes.Count == 0)
                {
                    <div class="source-tree-empty">
                        @(activeTree == TreeMode.Files
                            ? "No files from Git. This list comes from git ls-files — a local repo is enough: run git init here (no remote needed) and Refresh."
                            : "No indexed source.")
                    </div>
                }
                else
                {
                    @foreach (SourceTreeNode node in ActiveTreeNodes)
                    {
                        <SourceProjectTreeNode Node="@node"
                                               SelectedRelativePath="@SelectedPath"
                                               OnFileSelected="@SelectFile" />
                    }
                }
            </div>
        </aside>

        <div class="source-splitter" @ref="sourceSplitter" title="Drag to resize source panes" aria-hidden="true"></div>

        <section class="source-detail" @ref="sourceDetail" aria-label="Selected source file">
            @if (!string.IsNullOrWhiteSpace(Snapshot.Message))
            {
                <div class="inline-error">@Snapshot.Message</div>
            }

            @if (Snapshot.SelectedFile is null)
            {
                <div class="empty-source">Select a source file.</div>
            }
            else
            {
                <header class="source-detail-header">
                    <div>
                        <h2>@Snapshot.SelectedFile.RelativePath</h2>
                        <span>@Snapshot.SelectedFile.Language - @Snapshot.SelectedFile.Size.ToString("n0") bytes</span>
                    </div>
                </header>

                <SourceCodeViewer File="@Snapshot.SelectedFile" OnNavigate="@NavigateDocLink" />
            }
        </section>
    </div>
</div>

@code {
    [Parameter]
    public required SourceWorkspaceSnapshot Snapshot { get; set; }

    [Parameter]
    public string Filter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> FilterChanged { get; set; }

    [Parameter]
    public string FilesFilter { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> FilesFilterChanged { get; set; }

    [Parameter]
    public EventCallback ApplyFilesFilter { get; set; }

    [Parameter]
    public string? SelectedPath { get; set; }

    [Parameter]
    public bool IsRebuildingIndex { get; set; }

    [Parameter]
    public EventCallback ApplyFilter { get; set; }

    [Parameter]
    public EventCallback RebuildIndex { get; set; }

    [Parameter]
    public EventCallback AddProject { get; set; }

    [Parameter]
    public EventCallback<string> Build { get; set; }

    [Parameter]
    public EventCallback<SourceRunRequest> Run { get; set; }

    [Parameter]
    public EventCallback Stop { get; set; }

    [Parameter]
    public bool IsBuilding { get; set; }

    [Parameter]
    public EventCallback Reload { get; set; }

    [Parameter]
    public EventCallback<SourceSelection> SelectFile { get; set; }

    [Parameter]
    public EventCallback<DocLinkNavigation> NavigateDocLink { get; set; }

    [Parameter]
    public bool CanGoBack { get; set; }

    [Parameter]
    public bool CanGoForward { get; set; }

    [Parameter]
    public EventCallback Back { get; set; }

    [Parameter]
    public EventCallback Forward { get; set; }

    private ElementReference sourceLayout;
    private ElementReference sourceSidebar;
    private ElementReference sourceDetail;
    private ElementReference sourceSplitter;
    private ElementReference treeList;
    private IJSObjectReference? resizeModule;
    private bool showFilter;
    private string buildConfiguration = "Debug";
    private string selectedRunProject = string.Empty;

    private enum TreeMode { Solution, Files }

    private TreeMode activeTree = TreeMode.Solution;

    private IReadOnlyList<SourceTreeNode> ActiveTreeNodes =>
        activeTree == TreeMode.Files ? Snapshot.FilesTree : Snapshot.Tree;

    private int ActiveCount =>
        activeTree == TreeMode.Files ? Snapshot.FilesCount : Snapshot.Files.Count;

    private string ActiveFilter =>
        activeTree == TreeMode.Files ? FilesFilter : Filter;

    private void SetTree(TreeMode mode)
    {
        activeTree = mode;
    }

    private Task OnActiveFilterChanged(string? value)
    {
        return activeTree == TreeMode.Files
            ? FilesFilterChanged.InvokeAsync(value ?? string.Empty)
            : FilterChanged.InvokeAsync(value ?? string.Empty);
    }

    private Task ApplyActiveFilter()
    {
        return activeTree == TreeMode.Files ? ApplyFilesFilter.InvokeAsync() : ApplyFilter.InvokeAsync();
    }

    // Keep the picked startup project valid as the index changes: default to the first executable, and
    // re-default if the selected project was removed or the list came back empty.
    protected override void OnParametersSet()
    {
        IReadOnlyList<RunnableProjectEntry> runnable = Snapshot.RunnableProjects;
        if (runnable.Count == 0)
        {
            selectedRunProject = string.Empty;
        }
        else if (string.IsNullOrEmpty(selectedRunProject)
            || !runnable.Any(project => project.ProjectPath == selectedRunProject))
        {
            selectedRunProject = runnable[0].ProjectPath;
        }
    }

    private Task RunSelected()
    {
        return Run.InvokeAsync(new SourceRunRequest(buildConfiguration, selectedRunProject));
    }

    private Task OnFilterChanged(string? value)
    {
        return FilterChanged.InvokeAsync(value ?? string.Empty);
    }

    private void ToggleFilter()
    {
        showFilter = !showFilter;
    }

    private async Task CollapseAll()
    {
        if (resizeModule is not null)
        {
            await resizeModule.InvokeVoidAsync("setTreeExpanded", treeList, false);
        }
    }

    private async Task ExpandAll()
    {
        if (resizeModule is not null)
        {
            await resizeModule.InvokeVoidAsync("setTreeExpanded", treeList, true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        resizeModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/sourceResize.js");
        await resizeModule.InvokeVoidAsync(
            "attachSourceSplitter",
            sourceLayout,
            sourceSidebar,
            sourceDetail,
            sourceSplitter);
    }

    public async ValueTask DisposeAsync()
    {
        if (resizeModule is not null)
        {
            try
            {
                await resizeModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
