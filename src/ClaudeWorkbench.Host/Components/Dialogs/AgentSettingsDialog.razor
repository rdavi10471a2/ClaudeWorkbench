@if (Visible)
{
    <div class="settings-overlay" role="dialog" aria-modal="true" aria-label="Agent tool settings">
        <section class="settings-card">
            <header class="settings-header">
                <div>
                    <span class="settings-eyebrow">Agent</span>
                    <h3>Tool Settings</h3>
                </div>
                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@Cancel" />
            </header>

            <div class="settings-body">
                <label class="settings-row">
                    <input type="checkbox" @bind="draft.AllowNativeReads" />
                    <div class="settings-text">
                        <strong>Native read tools (Read / Grep / Glob)</strong>
                        <small>Let the agent read the watched workspace directly. Off forces all reads through the claude-workbench MCP.</small>
                    </div>
                </label>

                @* Locked OFF: a controlled A/B (2026-08-02) showed enabling the semantic edit family
                   increases round-trips ~50% with no benefit — the agent falls back to replace_text_in_file
                   even when they're offered and the card steers to them. Kept as a future bet: to re-enable,
                   remove `disabled` here (and see AgentToolSurface). The checkbox stays visible so the locked
                   default is legible, not hidden. *@
                <label class="settings-row settings-row--locked">
                    <input type="checkbox" @bind="draft.AllowSemanticEdits" disabled />
                    <div class="settings-text">
                        <strong>Semantic / structural edit tools <span class="settings-locked">locked · default off</span></strong>
                        <small>The Roslyn edit family (add_method, submit_symbol, replace_span, …). Withheld and locked: measured to add round-trips with no token saving over submit_file / replace_text_in_file (the runtime re-feeds the whole file each turn), and the agent prefers text editing anyway. Kept as a future bet — re-enable in code if revisiting.</small>
                    </div>
                </label>

                <label class="settings-row">
                    <input type="checkbox" @bind="draft.StrictMcpConfig" />
                    <div class="settings-text">
                        <strong>Isolate MCP surface</strong>
                        <small>Expose only claude-workbench; ignore the machine's account/user connectors (e.g. claude.ai connectors).</small>
                    </div>
                </label>

                <div class="settings-section-title">
                    Model &amp; reasoning
                    <span>applies to new threads (start a New Thread for a change to take effect)</span>
                </div>

                <div class="settings-row settings-select-row">
                    <div class="settings-text">
                        <strong>Model</strong>
                        <select class="settings-select" @bind="draft.Model">
                            @foreach (AgentModelOption option in AgentModelOptions.All)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="settings-row settings-select-row">
                    <div class="settings-text">
                        <strong>Reasoning level</strong>
                        <select class="settings-select" @bind="draft.Effort">
                            @foreach (string level in ReasoningLevels.All)
                            {
                                <option value="@level">@(string.IsNullOrEmpty(level) ? "Default" : level)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="settings-section-title">
                    Merge review
                    <span>applies the next time a review dialog opens</span>
                </div>

                <div class="settings-row settings-select-row">
                    <div class="settings-text">
                        <strong>Diff viewer</strong>
                        <select class="settings-select" @bind="draft.DiffViewer">
                            @foreach (DiffViewerOption option in DiffViewerOptions.All)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                        <small>The other viewer stays available (its tab is kept but disabled) so you can switch back.</small>
                    </div>
                </div>

                <label class="settings-row">
                    <input type="checkbox" @bind="draft.MergeReviewNewOnLeft" />
                    <div class="settings-text">
                        <strong>Merge Review: proposed change on the left</strong>
                        <small>Show the proposed (new) file on the left and current (old) on the right when accepting an edit. Off = old-left / new-right. The Git page always uses the conventional old-left order.</small>
                    </div>
                </label>

                <label class="settings-row">
                    <input type="checkbox" @bind="draft.DiffSwapColors" />
                    <div class="settings-text">
                        <strong>Reverse diff colors</strong>
                        <small>Insertions read red, deletions green (Monaco viewer). Pair with “proposed change on the left” so additions still read green on the proposed side. Applies to all Monaco diffs.</small>
                    </div>
                </label>

                <div class="settings-section-title">
                    Optional tools
                    <span>off by default &mdash; each one widens what the agent can do outside the governed gate</span>
                </div>

                @foreach (OptionalAgentTool tool in OptionalAgentTools.All)
                {
                    <label class="settings-row @(tool.Risky ? "risky" : string.Empty)">
                        <input type="checkbox"
                               checked="@draft.EnabledOptionalTools.Contains(tool.Name)"
                               @onchange="@(args => Toggle(tool.Name, (bool)(args.Value ?? false)))" />
                        <div class="settings-text">
                            <strong>@tool.Name @(tool.Risky ? "⚠" : string.Empty)</strong>
                            <small>@tool.Description</small>
                        </div>
                    </label>
                }
            </div>

            <footer class="settings-footer">
                <RadzenButton Text="Save" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@Save" />
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@Cancel" />
            </footer>
        </section>
    </div>
}
